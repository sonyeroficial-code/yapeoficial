{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "send-push.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "service-worker.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "VERCEL_PUSH_PASOS.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/send-push", "dest": "/send-push.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/service-worker.js", "dest": "/service-worker.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
